          0.714
        ],
        "hex": "#d8ceb6"
      }
    },
    "brand": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.98,
          0.788,
          0.29
        ],
        "hex": "#fac94a"
      }
    },
    "brand-hover": {
      "$value": {
        "colorSpace": "srgb",
