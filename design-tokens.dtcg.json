  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "2xl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "3xl": {
      "$value": {
        "value": 68,
        "unit": "px"
      }
    },
    "4xl": {
      "$value": {
        "value": 80,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "AlimamaShuHeiTi",
        "fontSize": {
          "value": 3,
          "unit": "rem"
        },
        "fontWeight": 900,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "AlimamaShuHeiTi",
        "fontSize": {
          "value": 1.4,
          "unit": "rem"
        },
        "fontWeight": 800
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "AlimamaShuHeiTi",
        "fontSize": {
          "value": 1.15,
          "unit": "rem"
        },
        "fontWeight": 800
      }
    },
    "section-title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "AlimamaShuHeiTi",
        "fontSize": {
          "value": 2.25,
          "unit": "rem"
        },
        "fontWeight": 900
      }
    },
    "section-kicker": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 700,
