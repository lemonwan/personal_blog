          "value": 17,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Noto Sans SC",
        "fontSize": {
          "value": 15,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "nav": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Noto Sans SC",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 900
      }
    },
    "code-inline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 0.88,
          "unit": "em"
        },
        "fontWeight": 500
      }
    },
    "mono-label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": 0.15,
          "unit": "em"
        }
      }
    }
